# Supabase Configuration
# VITE_* dipakai app (browser + server). Isi dengan nilai yang sama seperti di bawah.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI Configuration — SuperVibeCode (OpenAI-compatible)
# Buat key di https://app.supervibecode.ai.id/keys (simpan hanya di server, jangan di browser)
SUPERVIBECODE_API_KEY=sk-...
SUPERVIBECODE_BASE_URL=https://app.supervibecode.ai.id/v1
# Model chat (lihat https://app.supervibecode.ai.id/models), mis. gpt-4o-mini, gpt-5-mini, claude-haiku-4-5, sensenova-6.8-flash
AI_CHAT_MODEL=gpt-4o-mini
# Harus 1536 dimensi agar cocok dengan kolom vector(1536) di supabase-schema.sql
AI_EMBEDDING_MODEL=text-embedding-3-small
# Ambang minimum kemiripan cosine untuk konteks knowledge base (0-1)
AI_MATCH_THRESHOLD=0.3

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# App Configuration
# Alamat publik situs (dipakai untuk kode embed widget), mis. https://chat.domainkamu.com
APP_URL=http://localhost:5173

# Database Configuration (if using direct connection)
DATABASE_URL=your_database_connection_string

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=text/plain,application/pdf,text/markdown,text/csv,application/json

# Widget Configuration
WIDGET_SCRIPT_URL=http://localhost:5176/widget/chatbot.js
WIDGET_CSS_URL=http://localhost:5173/widget/chatbot.css